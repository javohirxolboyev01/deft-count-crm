# /etc/pbx-agent.env (chmod 600, egasi root)
CRM_URL=https://CRM-MANZILI
PBX_INGEST_TOKEN=CRM_DAGI_TOKEN_BILAN_BIR_XIL
CDR_FILE=/var/log/asterisk/cdr-csv/Master.csv
STATE_FILE=/var/lib/pbx-agent/state.json
POLL_SEC=5
# Audio yozuvlar papkasi (Asterisk MixMonitor, ichki papkalari bilan). Bo'sh qoldirilsa audio yuborilmaydi.
# Ofis serverida: /srv/records (extensions.conf RECORD_PATH)
REC_DIR=/var/spool/asterisk/monitor
REC_STATE_FILE=/var/lib/pbx-agent/recordings.json
# Shu sanadan eski yozuvlar yuborilmaydi (bo'sh = hammasi)
REC_SINCE=
# Ustunlar standartdan farq qilsa (cdr.conf [csv]): vergul bilan nomlari
# CDR_COLUMNS=accountcode,src,dst,dcontext,clid,channel,dstchannel,lastapp,lastdata,start,answer,end,duration,billsec,disposition,amaflags,uniqueid,userfield
